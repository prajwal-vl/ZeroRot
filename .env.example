# ZERO ROOT Environment Configuration Template

# Database configuration (Default is SQLite for local CPU dev; use PostgreSQL in production)
DATABASE_URL=sqlite:///./zeroroot.db

# Authentication & Security
AUTH_SECRET_KEY=zero-root-production-jwt-auth-key-2026-secure

# Groq API Configuration (Provides natural language explanations; falls back to deterministic rule engine if absent)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Public Mobile URL Configuration (Required for external QR code generation; localhost is strictly blocked)
# Set to your publicly accessible domain or tunnel (e.g., https://zeroroot.example.com or https://your-tunnel.ngrok-free.app)
PUBLIC_APP_URL=

# Live External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Open Government Data (OGD) Platform India — data.gov.in (Agmarknet Mandi Market Prices)
DATA_GOV_IN_API_KEY=your_api_key_here
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Telegram Bot Notifications (Periodic updates every 10 min & immediate critical alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Server
PORT=8000
HOST=0.0.0.0
